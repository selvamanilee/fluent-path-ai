{
  "name": "@fluentpath/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.ts",
    "seed": "node scripts/seed.ts",
    "db:reset": "node scripts/migrate.ts --reset && node scripts/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.18",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  }
}
