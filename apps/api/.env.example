DATABASE_URL=postgres://fluentpath:fluentpath@localhost:5432/fluentpath
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Internal agent service (optional — rule-based evaluation is used when unset/unavailable)
AGENT_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=change-me
AGENT_TIMEOUT_MS=20000
# Set to "true" behind HTTPS so the refresh cookie gets the Secure flag
COOKIE_SECURE=false
