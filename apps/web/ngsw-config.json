{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationRequestStrategy": "performance",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/offline.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"],
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "learning-content",
      "urls": ["/api/v1/content/**", "/api/v1/lessons", "/api/v1/lessons/*", "/api/v1/vocabulary/categories", "/api/v1/vocabulary/categories/*", "/api/v1/phrases", "/api/v1/reading", "/api/v1/reading/*"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 150, "maxAge": "7d", "timeout": "4s" }
    }
  ]
}
