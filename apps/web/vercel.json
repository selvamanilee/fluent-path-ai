{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx ng build",
  "outputDirectory": "dist/web",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api-rouge-five-51.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "microphone=(self), camera=()" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] },
    { "source": "/(ngsw.json|ngsw-worker.js|safety-worker.js|index.html|manifest.webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)-([A-Za-z0-9_-]{8}).(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
